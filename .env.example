# Salin menjadi .env (lokal). Di Vercel, isi nilai yang sama di Settings > Environment Variables.
# Nilai VITE_* ikut terbaca di sisi klien (memang demikian untuk Firebase web); rahasia sebenarnya
# (serviceAccount.json, keystore) TIDAK pernah dimasukkan ke sini.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pn-gresik.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pn-gresik
VITE_FIREBASE_STORAGE_BUCKET=pn-gresik.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=166896044233
VITE_FIREBASE_APP_ID=
# Alamat publik website (domain Vercel). Dipakai tombol "Lihat blog" di aplikasi Android/iOS,
# karena di dalam aplikasi alamat bawaannya https://localhost.
# VITE_SITE_URL=https://GANTI-DENGAN-DOMAIN-VERCEL.vercel.app
VITE_SITE_URL=https://localhost
# (opsional) URL backend Axum
VITE_API_URL=
